+
+    async def _fetch_search_repos(
+        self,
+        source: GitHubSourceConfig,
+        since: datetime,
+    ) -> List[ContentItem]:
+        """Fetch trending repositories via the GitHub search API.
+
+        GitHub has no public "trending" endpoint, so we approximate it the way
+        most trending trackers do: recently-created repos ranked by stars.
+        Unlike the OSS Insight trends API this returns projects people have
+        actually heard of, which is what the open-source digest section needs.
+
+        Note: results are *not* filtered by ``since``.  A repo that crossed the
+        star threshold today may have been created a week ago, and dropping it
+        would leave the section permanently empty.  Cross-run repetition is
+        handled downstream by topic dedup.
+        """
+        qualifiers = [f"stars:>={source.min_stars}"]
+        cutoff = datetime.now(timezone.utc) - timedelta(days=source.created_within_days)
+        qualifiers.append(f"created:>={cutoff.strftime('%Y-%m-%d')}")
+        if source.language:
+            qualifiers.append(f"language:{source.language}")
+        query = " ".join([source.query] if source.query else []) + " " + " ".join(qualifiers)
+
+        params = {
+            "q": query.strip(),
+            "sort": "stars",
+            "order": "desc",
+            "per_page": min(source.max_items, 100),
+        }
+        items: List[ContentItem] = []
+
+        try:
+            response = await self.client.get(
+                f"{self.base_url}/search/repositories",
+                params=params,
+                headers=self._get_headers(),
+                follow_redirects=True,
+            )
+            response.raise_for_status()
+            repos = response.json().get("items", [])
+        except httpx.HTTPError as e:
+            logger.warning("Error searching repos (%s): %s", query.strip(), e)
+            return items
+        except (ValueError, KeyError) as e:
+            logger.warning("Malformed repo search response for %s: %s", query.strip(), e)
+            return items
+
+        for repo in repos[: source.max_items]:
+            full_name = repo.get("full_name")
+            if not full_name:
+                continue
+
+            stars = repo.get("stargazers_count", 0)
+            description = (repo.get("description") or "").strip()
+            language = repo.get("primary_language") or repo.get("language") or "unknown"
+            topics = repo.get("topics") or []
+
+            content_lines = [
+                f"Trending GitHub repository: {full_name}",
+                f"Stars: {stars}",
+                f"Language: {language}",
+                f"Created: {repo.get('created_at', 'unknown')}",
+            ]
+            if topics:
+                content_lines.append(f"Topics: {', '.join(topics)}")
+            if description:
+                content_lines.extend(["", description])
+
+            try:
+                published_at = datetime.fromisoformat(
+                    repo["created_at"].replace("Z", "+00:00")
+                )
+            except (KeyError, ValueError):
+                published_at = datetime.now(timezone.utc)
+
+            items.append(
+                ContentItem(
+                    id=self._generate_id("github", "trending", str(repo.get("id", full_name))),
+                    source_type=SourceType.GITHUB,
+                    title=f"{full_name} — {description[:120]}" if description else full_name,
+                    url=repo.get("html_url", f"https://github.com/{full_name}"),
+                    content="\n".join(content_lines),
+                    author=(repo.get("owner") or {}).get("login", "unknown"),
+                    published_at=published_at,
+                    profile=source.profile,
+                    metadata={
+                        "repo": full_name,
+                        "stars": stars,
+                        "language": language,
+                        "topics": topics,
+                        "category": source.category,
+                    },
+                )
+            )
+
+        return items
