# Daily Tech Digest — configuration
# Copy to config.env and edit. config.env is gitignored.
# Every value below has a working default except SLACK_CHANNEL_ID.

# --- Paths -------------------------------------------------------------------
# Where runtime state lives (Horizon checkout, summaries, digests, podcasts).
DIGEST_HOME="${HOME}/Automation/daily-tech-digest"

# --- Horizon (news aggregation) ----------------------------------------------
# Upstream: https://github.com/Thysrael/Horizon (MIT).
# Pinned so patches/horizon-local.patch always applies; bump deliberately.
HORIZON_REPO="https://github.com/Thysrael/Horizon.git"
HORIZON_PIN="c33d733"

# Score cutoff, 0-10. Lower = more stories. 5.5 yields roughly 20-30/day.
HORIZON_THRESHOLD="5.5"

# --- Schedule ----------------------------------------------------------------
# Horizon must finish before the Claude routine reads its summary.
# A full run takes ~12 minutes, so leave at least 30 minutes of headroom.
HORIZON_HOUR="6"
HORIZON_MINUTE="45"
# Must be a literal: config.env is read by both bash and make, and make
# would parse $(...) as one of its own function calls.
LAUNCHD_LABEL="com.dailytechdigest.horizon"

# --- Slack delivery ----------------------------------------------------------
# Delivery uses this project's own Slack app (see docs/slack-app.md), not a
# Slack MCP server: only a bot token can upload the podcast MP3 as a real
# attachment.

# Channel the Claude routine posts the digest thread to. REQUIRED.
SLACK_CHANNEL_ID=""

# Bot token from the Slack app install. Prefer SLACK_TOKEN_FILE: it keeps the
# secret out of this file, which is otherwise safe to read aloud. Either works,
# and $SLACK_BOT_TOKEN in the environment overrides both.
SLACK_TOKEN_FILE="${HOME}/.config/daily-tech-digest/slack.env"
SLACK_BOT_TOKEN=""

# --- Podcast (podcastfy) -----------------------------------------------------
# https://github.com/souzatharsis/podcastfy (Apache-2.0)
PODCAST_ENABLED="true"

# edge = free, no API key. Also: openai, elevenlabs, gemini (each needs a key).
PODCAST_TTS_MODEL="edge"

# How the script is written. "claude-cli" reuses your logged-in Claude Code CLI
# and needs no API key. "podcastfy" uses podcastfy's own LLM (needs GEMINI_API_KEY
# or whatever PODCAST_LLM_API_KEY_LABEL names).
PODCAST_SCRIPT_ENGINE="claude-cli"
PODCAST_LLM_MODEL="claude-sonnet-5"
PODCAST_LLM_API_KEY_LABEL="GEMINI_API_KEY"

# Top N stories to cover. Keep modest — every story adds roughly a minute.
PODCAST_MAX_STORIES="8"
PODCAST_NAME="Daily Tech Digest"
PODCAST_TAGLINE="Your morning briefing, automatically assembled"
PODCAST_VOICE_1="en-US-AndrewNeural"
PODCAST_VOICE_2="en-US-EmmaNeural"

# --- Claude routine ----------------------------------------------------------

# Optional RSS feed for a video-highlights section in the digest. Leave empty
# to skip that section. (The AI Engineer channel id previously hardcoded here
# now 404s, so there is no default.)
AI_ENGINEER_FEED=""
