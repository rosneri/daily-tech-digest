<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@@LABEL@@</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>@@REPO_ROOT@@/scripts/run-horizon.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>@@HOUR@@</integer>
        <key>Minute</key>
        <integer>@@MINUTE@@</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>@@DIGEST_HOME@@/horizon-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>@@DIGEST_HOME@@/horizon-stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@@HOME@@</string>
        <!-- Without this, rich truncates file paths in the log to something
             misleading, which makes post-hoc debugging much harder. -->
        <key>COLUMNS</key>
        <string>200</string>
    </dict>
</dict>
</plist>
